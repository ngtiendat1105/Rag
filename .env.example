RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="Legal AI <dev@your-domain.com>"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
AUTH_SESSION_SECRET=generate_a_random_secret_with_at_least_32_characters

# Kết nối server-side từ Next.js tới Python RAG API.
# Không thêm tiền tố NEXT_PUBLIC_ cho LEGALAI_API_KEY.
RAG_API_URL=http://127.0.0.1:8000
LEGALAI_API_KEY=generate_a_private_api_key
RAG_REQUEST_TIMEOUT_MS=180000
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
RAG_TOP_K=3
RAG_MAX_CONTEXT_DOCUMENTS=3
RAG_MAX_CONTEXT_CHARS=8000
RAG_MAX_OUTPUT_TOKENS=700

