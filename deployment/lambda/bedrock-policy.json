{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeNovaLiteProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:us-east-1:454550198561:inference-profile/us.amazon.nova-lite-v1:0"
    },
    {
      "Sid": "InvokeNovaLiteThroughProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/amazon.nova-lite-v1:0"
      ],
      "Condition": {
        "StringEquals": {
          "bedrock:InferenceProfileArn": "arn:aws:bedrock:us-east-1:454550198561:inference-profile/us.amazon.nova-lite-v1:0"
        }
      }
    }
  ]
}
