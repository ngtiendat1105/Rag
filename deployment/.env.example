# Backend Lambda: AWS credentials come from its execution role.
LEGALAI_API_KEY=replace-with-a-long-random-secret
RAG_LLM_PROVIDER=bedrock
RAG_LLM_MODEL=us.amazon.nova-lite-v1:0
BEDROCK_REGION=us-east-1
CORS_ALLOWED_ORIGINS=https://legalai.id.vn,https://www.legalai.id.vn
QDRANT_URL=https://your-cluster.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
RAG_TOP_K=3
RAG_RETRIEVAL_TOP_K=3
RAG_RERANK_TOP_N=3
RAG_RERANKER_MODEL=
RAG_MAX_CONTEXT_DOCUMENTS=3
RAG_MAX_CONTEXT_CHARS=8000
RAG_MAX_OUTPUT_TOKENS=700
LLM_REQUEST_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=0
RAG_SIMILARITY_THRESHOLD=0.3
RAG_USE_METADATA_FILTERING=false
LEGALAI_RATE_LIMIT=20
LEGALAI_RATE_WINDOW_SECONDS=60
QDRANT_TIMEOUT_SECONDS=10

# Frontend Amplify: keep these server-side (no NEXT_PUBLIC_ prefix).
RAG_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
RAG_REQUEST_TIMEOUT_MS=120000
