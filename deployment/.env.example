RAG_DOMAIN=api.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
LEGALAI_API_KEY=generate-a-long-random-value
QDRANT_API_KEY=generate-a-different-long-random-value
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=llama3.2:latest
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
RAG_TOP_K=8
RAG_RETRIEVAL_TOP_K=8
RAG_RERANK_TOP_N=3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_MAX_CONTEXT_DOCUMENTS=3
RAG_MAX_CONTEXT_CHARS=8000
RAG_MAX_OUTPUT_TOKENS=700
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
RAG_SIMILARITY_THRESHOLD=0.3
RAG_USE_METADATA_FILTERING=false
LEGALAI_RATE_LIMIT=20
LEGALAI_RATE_WINDOW_SECONDS=60
QDRANT_TIMEOUT_SECONDS=10
