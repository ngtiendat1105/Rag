RAG_DOMAIN=api.legalai.id.vn
LEGALAI_API_KEY=replace-with-a-long-random-secret
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=llama3.2:latest
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREAD=16
RAG_TOP_K=3
RAG_RERANK_TOP_N=12
RAG_RERANKER_MAX_CANDIDATES=8
RAG_ENABLE_RERANKER=false
RAG_EMBEDDING_CACHE_SIZE=128
RAG_QUERY_CACHE_SIZE=64
RAG_QUERY_CACHE_TTL_SECONDS=30
RAG_MAX_CONTEXT_DOCUMENTS=3
RAG_MAX_CONTEXT_CHARS=8000
RAG_MAX_OUTPUT_TOKENS=700
LEGALAI_RATE_LIMIT=20
LEGALAI_RATE_WINDOW_SECONDS=60
